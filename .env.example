# Публичный адрес сайта — для canonical, sitemap и Open Graph.
# Если сайт живёт в подпапке, путь указывается здесь целиком.
NEXT_PUBLIC_SITE_URL=https://example.com

# Подпапка домена, если сайт не в корне (например, /clear). Пусто — сайт в корне.
# Читается и при сборке, и при запуске; после изменения нужна пересборка.
# NEXT_PUBLIC_BASE_PATH=/clear

# Приём заявок. Пока ничего не задано — форма работает в демо-режиме
# (заявка никуда не уходит, пользователь видит честное предупреждение).
#
# Вариант 1: любой webhook (CRM, n8n, Make, Zapier, свой backend).
# LEAD_WEBHOOK_URL=https://hooks.example.com/blik

# Вариант 2: сообщение в Telegram.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-1001234567890
